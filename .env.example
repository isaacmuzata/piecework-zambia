# Copy to .env and fill in before running.
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# Comma-separated list of allowed origins for CORS. Same-origin is always fine.
# Leave empty to allow all origins (not recommended in production).
ALLOWED_ORIGINS=
